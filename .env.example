# Copie para ".env" (cp .env.example .env) e ajuste os valores.
# O arquivo .env NUNCA deve ser enviado ao Git.

# Banco de dados
POSTGRES_DB=usersdb
POSTGRES_USER=app
POSTGRES_PASSWORD=troque-esta-senha

# JWT: mínimo de 32 caracteres (a aplicação não sobe com menos)
JWT_SECRET=troque-por-um-segredo-longo-com-pelo-menos-32-caracteres
JWT_EXPIRATION_MINUTES=60

# ADMIN criado na primeira subida
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=Troque@123

# Origem do frontend liberada no CORS (separe várias por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Swagger UI e /v3/api-docs
SWAGGER_ENABLED=true
