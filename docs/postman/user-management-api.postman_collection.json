      "name": "1. Autenticação",
      "item": [
        {
          "name": "1.1 Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@local.dev\",\n  \"password\": \"Admin@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().accessToken;",
                  "pm.test(\"Token presente\", () => pm.expect(t).to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"adminToken\", t);",
                  "let p = t.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
                  "p = p + \"=\".repeat((4 - (p.length % 4)) % 4);",
                  "const claims = JSON.parse(atob(p));",
                  "pm.test(\"Claim role = ADMIN\", () => pm.expect(claims.role).to.eql(\"ADMIN\"));",
                  "pm.collectionVariables.set(\"adminId\", claims.userId);"
                ]
              }
            }
          ]
        },
