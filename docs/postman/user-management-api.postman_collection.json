            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria Silva\",\n  \"email\": \"maria@teste.com\",\n  \"phone\": \"11999990000\",\n  \"password\": \"Senha@1234\",\n  \"role\": \"USER\",\n  \"addresses\": [\n    {\"cep\": \"01001000\", \"street\": \"Praca da Se\", \"number\": \"100\", \"state\": \"SP\", \"city\": \"Sao Paulo\", \"district\": \"Se\", \"mainAddress\": true}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Header Location presente\", () => pm.expect(pm.response.headers.has(\"Location\")).to.be.true);",
                  "pm.test(\"Resposta não expõe senha\", () => pm.expect(b).to.not.have.property(\"password\"));",
                  "pm.test(\"E-mail em minúsculas\", () => pm.expect(b.email).to.eql(\"maria@teste.com\"));",
                  "pm.test(\"Status ACTIVE\", () => pm.expect(b.status).to.eql(\"ACTIVE\"));",
                  "pm.test(\"Auditoria: createdBy = admin\", () => pm.expect(b.createdBy).to.eql(\"admin@local.dev\"));",
                  "pm.test(\"Um endereço principal\", () => pm.expect(b.addresses.filter(a => a.mainAddress).length).to.eql(1));",
                  "pm.collectionVariables.set(\"mariaId\", b.id);",
                  "pm.collectionVariables.set(\"mariaAddressId\", b.addresses[0].id);"
                ]
              }
            }
          ]
        },
